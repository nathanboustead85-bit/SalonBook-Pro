{
  "name": "salonbook-pro-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Secure backend for Boustio salon booking platform",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "node --check index.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test:booking-readiness": "node ../tests/customer_booking_readiness.test.js",
    "test:booking-integration": "node ../tests/customer_booking_readiness.test.js && node ../tests/legacy_booking_audit.test.js && node ../tests/migration_inspection_integration.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "google-auth-library": "^9.15.1"
  }
}
