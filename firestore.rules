rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================
    // SHARED SECURITY FUNCTIONS
    // ===================================

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId)
        && request.auth.token.email_verified == true;
    }

    // PHASE 8D.61:
    // Completed migration marker.
    // Only trusted backend can create it.

    function migrationCompleted(userId) {
      return exists(
        /databases/$(database)/documents/businesses/$(userId)/migrations/android-bookings-v1
      );
    }

    // ===================================
    // PHASE 8D.68: BOOKING MODE GUARD
    // ===================================

    function bookingModePath(userId) {
      return /databases/$(database)/documents/businesses/$(userId)/settings/bookingMode;
    }

    // Transitional compatibility:
    //
    // Missing mode:
    //   Existing legacy clients remain
    //   compatible until backend rollout.
    //
    // legacy:
    //   Legacy booking uploads permitted.
    //
    // frozen/cloud/invalid:
    //   Legacy booking uploads denied.
    //
    // Migration marker always blocks
    // legacy booking uploads.

    function legacyBookingWriteAllowed(userId) {
      return !migrationCompleted(userId)
        && (
          !exists(bookingModePath(userId))
          || get(bookingModePath(userId)).data.mode == "legacy"
        );
    }

    // ===================================
    // PHASE 5: CLOUD BACKUP AND RESTORE
    // ===================================

    match /users/{userId}/backups/{backupId} {

      allow read, write: if isOwner(userId)
        && backupId == "latest";
    }

    // ===================================
    // PHASE 6: CLOUD SYNCHRONISATION
    // PHASE 8D.68: MODE PROTECTION
    // ===================================

    match /users/{userId}/liveData/{dataType} {

      allow read: if isVerifiedOwner(userId)
        && dataType in [
          "bookings",
          "services",
          "staff"
        ];

      allow create, update: if isVerifiedOwner(userId)
        && dataType in [
          "bookings",
          "services",
          "staff"
        ]

        && (
          dataType != "bookings"
          || legacyBookingWriteAllowed(userId)
        )

        && request.resource.data.keys().hasOnly([
          "json",
          "schemaVersion",
          "updatedAt"
        ])

        && request.resource.data.json is string

        && request.resource.data.schemaVersion == 1

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.json.size() <= 500000;

      allow delete: if false;
    }

    // PHASE 12.11A: private, verified-owner client profiles.
    // Names are immutable on updates: renames require explicit migration.
    match /users/{userId}/clientProfiles/{profileId} {
      allow get: if isVerifiedOwner(userId);
      allow list, delete: if false;
      allow create, update: if isVerifiedOwner(userId)
        && profileId.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'notes', 'schemaVersion', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'email', 'notes', 'schemaVersion', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 50
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 5000
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.name == resource.data.name);
    }

    // ===================================
    // PHASE 7A: PRIVATE BUSINESS PROFILE
    // ===================================

    match /users/{userId}/business/{documentId} {

      allow read: if isVerifiedOwner(userId)
        && documentId == "profile";

      allow create, update: if isVerifiedOwner(userId)
        && documentId == "profile"

        && request.resource.data.keys().hasOnly([
          "businessId",
          "name",
          "slug",
          "category",
          "email",
          "phone",
          "address",
          "description",
          "acceptingBookings",
          "schemaVersion",
          "updatedAt"
        ])

        && request.resource.data.keys().hasAll([
          "businessId",
          "name",
          "slug",
          "category",
          "email",
          "phone",
          "address",
          "description",
          "acceptingBookings",
          "schemaVersion",
          "updatedAt"
        ])

        && request.resource.data.businessId is string
        && request.resource.data.businessId == userId

        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.category is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.description is string

        && request.resource.data.acceptingBookings is bool

        && request.resource.data.schemaVersion == 1

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100

        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 50

        && request.resource.data.category.size() <= 100
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone.size() <= 50
        && request.resource.data.address.size() <= 500
        && request.resource.data.description.size() <= 2000

        && request.resource.data.acceptingBookings == false;

      allow delete: if false;
    }

    // ===================================
    // PHASE 7C: PUBLIC BUSINESS DIRECTORY
    // ===================================

    match /publicBusinesses/{businessId} {

      allow get: if resource.data.published == true;

      allow list: if false;

      allow create, update, delete: if false;
    }

    // ===================================
    // PHASE 8C: PRIVATE APPOINTMENTS
    // ===================================

    match /businesses/{businessId}/appointments/{appointmentId} {

      allow get, list: if isVerifiedOwner(businessId);

      // Appointment changes must go
      // through the trusted backend.

      allow create, update, delete: if false;
    }

    // ===================================
    // PHASE 8C: BOOKING LOCKS
    // ===================================

    match /businesses/{businessId}/bookingLocks/{lockId} {

      allow read, write: if false;
    }

    // ===================================
    // PHASE 8D.63: BOOKING MODE
    // ===================================

    match /businesses/{businessId}/settings/{settingId} {

      // Verified owner can read mode.

      allow get: if isVerifiedOwner(businessId)
        && settingId == "bookingMode";

      // Only trusted backend can
      // create or modify mode.

      allow list, create, update, delete: if false;
    }

    // ===================================
    // PHASE 8D.61: MIGRATION MARKERS
    // ===================================

    match /businesses/{businessId}/migrations/{migrationId} {

      // No client access to markers.

      allow read, write: if false;
    }

    // ===================================
    // PHASE 9E.1: PRIVATE CHAT FOUNDATION
    // ===================================
    // Conversation creation and customer messages will be performed by
    // authenticated, rate-limited backend endpoints in later phases.
    // Never permit anonymous visitors to write directly to Firestore.

    match /businesses/{businessId}/conversations/{conversationId} {
      allow get, list: if isVerifiedOwner(businessId);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isVerifiedOwner(businessId);
        allow create, update, delete: if false;
      }
    }

    // ===================================
    // DEFAULT DENY
    // ===================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
