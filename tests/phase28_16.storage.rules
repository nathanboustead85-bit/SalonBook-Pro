rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phase 28.16: staging-only, deny-by-default storage policy.
    // Do NOT connect to firebase.json or deploy until independently audited.
    // Only a trusted backend using Admin SDK can handle pending uploads.
    // Admin SDK bypasses Storage rules; backend authorization is mandatory.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
